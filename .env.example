# Copy to .env (never commit). All values below are placeholders.

# Base URL of the Drivo API / service layer (NOT the database, NOT raw Odoo RPC)
DRIVO_API_BASE_URL=https://demo.drivo.biz
DRIVO_API_TIMEOUT_MS=15000

# HTTP transport
PORT=3000
HOST=0.0.0.0
MCP_ALLOWED_HOSTS=mcp.drivo.biz
MCP_ALLOWED_ORIGINS=https://claude.ai

# Transport: "http" (remote, default) or "stdio" (local clients)
MCP_TRANSPORT=http

# Principal registry: JSON file (preferred) -- see principals.example.json.
# Holds sha256 key hashes, scopes, company allowlist and the NAME of the env
# var carrying that principal's upstream Drivo bearer token.
DRIVO_MCP_PRINCIPALS_FILE=/run/secrets/drivo-mcp-principals.json

# One upstream Drivo bearer token per principal, referenced by name from the
# registry (upstreamTokenEnv). Issue via POST /api/v1/auth/login for a
# dedicated least-privilege Drivo user.
DRIVO_UPSTREAM_TOKEN_EXAMPLE_PRINCIPAL=replace-me

# Random 32+ byte secret used to sign high-risk confirmation tokens
DRIVO_MCP_CONFIRM_SECRET=replace-with-random-32-bytes

# Rate limit (per principal)
DRIVO_MCP_RATE_LIMIT_PER_MINUTE=60
DRIVO_MCP_WRITE_RATE_LIMIT_PER_MINUTE=20

LOG_LEVEL=info
