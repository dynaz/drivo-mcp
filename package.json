{
  "name": "@dynaz/drivo-mcp",
  "mcpName": "biz.drivo/drivo-erp",
  "version": "0.1.0",
  "description": "Secure, domain-oriented MCP server for the Drivo dealer business platform",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "drivo-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md", "server.json"],
  "repository": { "type": "git", "url": "git+https://github.com/dynaz/drivo-mcp.git" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "hash-key": "node -e \"const c=require('crypto');const k=process.argv[1]||c.randomBytes(32).toString('base64url');console.log('key :',k);console.log('hash:','sha256:'+c.createHash('sha256').update(k).digest('hex'))\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
